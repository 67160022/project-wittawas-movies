          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {\n  pm.response.to.have.status(201);\n});\n\nif (pm.response.code === 201) {\n  const body = pm.response.json();\n\n  pm.test(\"Response contains director_id\", function () {\n    pm.expect(body.data.director_id).to.be.a(\"number\");\n  });\n\n  pm.test(\"Name is saved as sent\", function () {\n    pm.expect(body.data.name).to.eql(pm.environment.get(\"testDirectorName\"));\n  });\n\n  // ใช้ต่อใน request อื่นได้ เช่น POST /movies ด้วย director_id ของผู้กำกับใหม่\n  pm.environment.set(\"directorId\", body.data.director_id);\n}"
            ]
          }
        }
      ],
